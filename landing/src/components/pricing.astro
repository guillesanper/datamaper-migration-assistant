---
import { Icon } from "astro-icon/components";
import ContentSection from "~/components/content-section.astro";

const plans = [
  {
    name: "Gratis",
    price: "0",
    period: "mes",
    features: [
      "1 proyecto activo",
      "Hasta 10 tablas por proyecto",
      "Mapeo básico de campos",
      "Exportación a SQL",
    ],
    cta: "Comenzar Gratis",
    ctaUrl: "/register",
    highlighted: false,
  },
  {
    name: "Premium",
    price: "30",
    period: "mes",
    features: [
      "Proyectos ilimitados",
      "Tablas ilimitadas",
      "Mapeo automático inteligente",
      "Exportación avanzada (SQL, Scripts, Docs)",
      "Colaboración en equipo",
      "Soporte prioritario",
    ],
    cta: "Empezar Ahora",
    ctaUrl: "/register",
    highlighted: true,
  },
];
---

<ContentSection title="Precios" id="pricing">
  <Fragment slot="lead">
    Empieza <span class="gradient-text-alt font-bold">gratis</span> y escala cuando lo necesites.
    Sin costes ocultos, <span class="gradient-text-alt font-bold">sin sorpresas</span>.
  </Fragment>
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 md:grid-cols-2 lg:gap-12">
    {
      plans.map((plan, index) => (
        <div
          class:list={[
            "card group relative overflow-hidden animate-fade-in-up",
            plan.highlighted
              ? "card-gradient from-blue-600/10 via-purple-600/10 to-pink-600/10 border-2 border-purple-500/50 shadow-2xl shadow-purple-500/20 scale-105 md:scale-110"
              : "card-glass",
          ]}
          style={`animation-delay: ${index * 0.2}s`}
        >
          {plan.highlighted && (
            <div class="absolute -top-3 -right-3 bg-gradient-to-r from-blue-500 to-purple-600 text-white px-4 py-1 rounded-full text-xs font-bold rotate-12 shadow-lg">
              Popular
            </div>
          )}

          <div class="flex flex-col p-8 md:p-10 relative z-10">
            <div class="mb-8 text-center">
              <h3 class="mb-4 text-3xl font-bold group-hover:scale-105 transition-transform font-display" style="color: var(--color-text);">
                {plan.name}
              </h3>
              <div class="flex items-baseline justify-center gap-2">
                <span class={plan.highlighted ? "text-6xl font-extrabold gradient-text font-display" : "text-6xl font-extrabold font-display"} style={!plan.highlighted ? "color: var(--color-text);" : ""}>
                  {plan.price}€
                </span>
                <span class="text-xl font-semibold" style="color: var(--color-text-offset);">/{plan.period}</span>
              </div>
            </div>

            <ul class="mb-10 flex-1 space-y-4">
              {plan.features.map((feature, featureIndex) => (
                <li
                  class="flex items-start gap-3 animate-fade-in-up"
                  style={`animation-delay: ${(index * 0.2) + (featureIndex * 0.05)}s`}
                >
                  <div class="flex-shrink-0 mt-0.5">
                    <div class={plan.highlighted ? "size-6 rounded-full bg-gradient-to-br from-green-400 to-emerald-500 flex items-center justify-center" : "size-6 rounded-full bg-green-500/20 flex items-center justify-center"}>
                      <Icon
                        name="mdi:check"
                        class="size-4 text-white"
                      />
                    </div>
                  </div>
                  <span class="text-base leading-relaxed" style="color: var(--color-text);">{feature}</span>
                </li>
              ))}
            </ul>

            <a
              href={plan.ctaUrl}
              class:list={[
                "group/btn relative overflow-hidden",
                plan.highlighted
                  ? "btn btn-primary w-full text-lg py-4"
                  : "btn btn-secondary w-full text-lg py-4",
              ]}
            >
              <span class="relative z-10 flex items-center justify-center gap-2">
                {plan.cta}
                <svg class="w-5 h-5 group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </span>
            </a>
          </div>

          {plan.highlighted && (
            <div class="absolute inset-0 opacity-50">
              <div class="absolute top-0 left-0 w-32 h-32 bg-blue-500/30 rounded-full blur-3xl animate-blob"></div>
              <div class="absolute bottom-0 right-0 w-32 h-32 bg-purple-500/30 rounded-full blur-3xl animate-blob animation-delay-200"></div>
            </div>
          )}
        </div>
      ))
    }
  </div>

  <!-- Money-back guarantee badge -->
  <div class="mt-16 flex justify-center">
    <div class="card card-glass px-8 py-4 flex items-center gap-4 max-w-md animate-fade-in animation-delay-700">
      <div class="size-12 rounded-full bg-gradient-to-br from-green-400 to-emerald-500 flex items-center justify-center flex-shrink-0">
        <Icon name="mdi:shield-check" class="size-7 text-white" />
      </div>
      <div>
        <p class="font-semibold text-base font-display" style="color: var(--color-text);">Garantía de 30 días</p>
        <p class="text-base" style="color: var(--color-text);">Prueba sin riesgo. Reembolso completo si no estás satisfecho.</p>
      </div>
    </div>
  </div>
</ContentSection>
