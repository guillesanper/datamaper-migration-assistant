---
import { Icon } from "astro-icon/components";
---

<section id="contact" class="relative py-32 overflow-hidden" style="background: linear-gradient(135deg, var(--color-background-offset) 0%, var(--color-background) 100%);">
  <!-- Animated background elements -->
  <div class="absolute top-0 left-0 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl animate-blob"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-purple-500/20 rounded-full blur-3xl animate-blob animation-delay-200"></div>

  <div class="container mx-auto px-8 relative z-10">
    <div class="mx-auto max-w-5xl">
      <div class="text-center mb-16 animate-fade-in-down">
        <h2 class="mb-6 text-5xl md:text-6xl font-extrabold" style="color: var(--color-text);">
          ¿Tienes alguna <span class="gradient-text">pregunta</span>?
        </h2>
        <p class="text-xl max-w-2xl mx-auto leading-relaxed" style="color: var(--color-text);">
          Estamos aquí para ayudarte. Contáctanos y te responderemos lo antes posible.
        </p>
      </div>

      <div class="flex flex-col items-center gap-6 mb-20 animate-fade-in-up animation-delay-200">
        <a
          href="mailto:datamapassistant@gmail.com"
          class="btn btn-primary group text-lg px-8 py-4 shadow-2xl shadow-purple-500/30"
        >
          <span class="flex items-center gap-3">
            <Icon name="mdi:email" class="size-7 group-hover:scale-110 transition-transform" />
            datamapassistant@gmail.com
            <Icon name="mdi:arrow-right" class="size-6 group-hover:translate-x-2 transition-transform" />
          </span>
        </a>
        <p class="text-sm flex items-center gap-2" style="color: var(--color-text-offset);">
          <Icon name="mdi:shield-check" class="size-5 text-green-400" />
          Respuesta garantizada en menos de 24 horas
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        <div class="card card-glass group hover:scale-105 transition-all duration-300 animate-fade-in-up animation-delay-300">
          <div class="flex flex-col items-center gap-4 p-8 text-center">
            <div class="size-16 rounded-full bg-gradient-to-br from-blue-500 to-blue-600 p-1 group-hover:scale-110 group-hover:rotate-12 transition-all duration-300">
              <div class="size-full rounded-full bg-slate-900 flex items-center justify-center">
                <Icon name="mdi:clock-fast" class="size-9 text-blue-400" />
              </div>
            </div>
            <h3 class="font-bold text-xl" style="color: var(--color-text);">Respuesta Rápida</h3>
            <p class="leading-relaxed" style="color: var(--color-text);">
              Respondemos en menos de 24 horas laborables
            </p>
            <div class="absolute top-4 right-4 w-2 h-2 bg-blue-400 rounded-full animate-pulse opacity-0 group-hover:opacity-100"></div>
          </div>
        </div>

        <div class="card card-glass group hover:scale-105 transition-all duration-300 animate-fade-in-up animation-delay-400">
          <div class="flex flex-col items-center gap-4 p-8 text-center">
            <div class="size-16 rounded-full bg-gradient-to-br from-purple-500 to-purple-600 p-1 group-hover:scale-110 group-hover:rotate-12 transition-all duration-300">
              <div class="size-full rounded-full bg-slate-900 flex items-center justify-center">
                <Icon name="mdi:help-circle" class="size-9 text-purple-400" />
              </div>
            </div>
            <h3 class="font-bold text-xl" style="color: var(--color-text);">Soporte Técnico</h3>
            <p class="leading-relaxed" style="color: var(--color-text);">
              Asistencia especializada para resolver tus dudas
            </p>
            <div class="absolute top-4 right-4 w-2 h-2 bg-purple-400 rounded-full animate-pulse opacity-0 group-hover:opacity-100"></div>
          </div>
        </div>

        <div class="card card-glass group hover:scale-105 transition-all duration-300 animate-fade-in-up animation-delay-500">
          <div class="flex flex-col items-center gap-4 p-8 text-center">
            <div class="size-16 rounded-full bg-gradient-to-br from-pink-500 to-pink-600 p-1 group-hover:scale-110 group-hover:rotate-12 transition-all duration-300">
              <div class="size-full rounded-full bg-slate-900 flex items-center justify-center">
                <Icon name="mdi:account-group" class="size-9 text-pink-400" />
              </div>
            </div>
            <h3 class="font-bold text-xl" style="color: var(--color-text);">Equipo Dedicado</h3>
            <p class="leading-relaxed" style="color: var(--color-text);">
              Expertos en migraciones y mapeo de datos
            </p>
            <div class="absolute top-4 right-4 w-2 h-2 bg-pink-400 rounded-full animate-pulse opacity-0 group-hover:opacity-100"></div>
          </div>
        </div>
      </div>

      <!-- Additional CTA -->
      <div class="mt-16 text-center animate-fade-in animation-delay-700">
        <div class="card card-glass inline-block px-8 py-6">
          <p class="text-lg mb-4" style="color: var(--color-text);">
            ¿Prefieres hablar directamente con nosotros?
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/register" class="btn btn-secondary group">
              <span class="flex items-center gap-2">
                <Icon name="mdi:calendar" class="size-5" />
                Agendar una Demo
                <Icon name="mdi:arrow-right" class="size-5 group-hover:translate-x-1 transition-transform" />
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
