# Example environment file for local development
# Copy this file to .env and adjust the values as needed.

# =========================
# Application
# =========================
ENV=development
SECRET_KEY=change-me-in-production
SECURE_COOKIES=false

# =========================
# Database (PostgreSQL)
# =========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=datamap_dev
DB_USER=datamaper_user_local
DB_PASSWORD=DataMap1234

# Optional test database settings
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres

# =========================
# Redis
# =========================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

# =========================
# Encryption / Security
# =========================
ENCRYPTION_ENABLED=true
ENCRYPTION_MASTER_KEY=change-me-32-bytes-or-longer
ENCRYPTION_SESSION_TIMEOUT=10800
ENABLE_KEY_ROTATION=false
ENABLE_ENCRYPTION_SESSION_REFRESH=true
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
IP_HASH_SALT=change-me
AUTO_PURGE_ON_PROJECT_COMPLETE=false
SESSION_ROTATION_GRACE_PERIOD=30
ENCRYPTION_CLEANUP_INTERVAL_MINUTES=15
RATE_LIMITER_CLEANUP_INTERVAL_MINUTES=60

# Rate limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_REGISTER_ATTEMPTS=3
RATE_LIMIT_REGISTER_WINDOW=3600
RATE_LIMIT_FORGOT_ATTEMPTS=3
RATE_LIMIT_FORGOT_WINDOW=3600
RATE_LIMIT_VERIFY_ATTEMPTS=10
RATE_LIMIT_VERIFY_WINDOW=3600
PASSPHRASE_MAX_ATTEMPTS=5
PASSPHRASE_WINDOW_SECONDS=600
PASSPHRASE_LOCKOUT_SECONDS=900

# CSRF / security headers
CSRF_TOKEN_LENGTH=32
CSRF_TOKEN_EXPIRY=3600
CSRF_SECRET_KEY=
DISABLE_CSRF_IN_DEV=true
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=1800
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https://api.stripe.com https://cdn.jsdelivr.net; frame-src https://js.stripe.com https://hooks.stripe.com;
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION=1; mode=block
REFERRER_POLICY=strict-origin-when-cross-origin
STRICT_TRANSPORT_SECURITY=max-age=31536000; includeSubDomains
SECURITY_LOG_LEVEL=INFO
LOG_FAILED_ATTEMPTS=true
LOG_SUCCESSFUL_LOGINS=true
HASH_IP_ADDRESSES=true
DATA_RETENTION_DAYS=90
CLEANUP_INTERVAL_HOURS=24
SECURITY_LOGS_RETENTION_DAYS=90
RATE_LIMIT_RETENTION_DAYS=7
CSRF_TOKEN_RETENTION_DAYS=1

# =========================
# Email
# =========================
EMAIL_FROM=change-me@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# =========================
# Stripe
# =========================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_WEBHOOK_SECRET=
BASE_URL=http://localhost:8000

# =========================
# Admin / Users
# =========================
ADMIN_USER_IDS=

# =========================
# Frontend
# =========================
VITE_API_URL=http://localhost:8000
